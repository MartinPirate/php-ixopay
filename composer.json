{
    "name": "ixopay/ixopay-php-client",
    "description": "Ixopay Client for PHP",
    "keywords": [
        "ixopay"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=v8.1",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "psr/log": "^1.0.0 || ^2.0.0 || ^3.0.0"
    },
    "require-dev": {
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "php-parallel-lint/php-console-highlighter": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "illuminate/contracts": "Required to use the Laravel service provider and facade integration.",
        "illuminate/support": "Required to use the Laravel service provider and facade integration."
    },
    "scripts": {
        "phpstan": [
            "./vendor/bin/phpstan analyze -l 3 --memory-limit=512M -- src examples tools"
        ],
        "parallel-lint": [
            "vendor/bin/parallel-lint --colors --blame ."
        ],
        "phpunit": [
            "./vendor/bin/phpunit"
        ],
        "recipes:build": [
            "php tools/recipes/build.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "Ixopay\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ixopay\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ixopay\\Client\\Laravel\\IxopayServiceProvider"
            ],
            "aliases": {
                "Ixopay": "Ixopay\\Client\\Laravel\\Facades\\Ixopay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
